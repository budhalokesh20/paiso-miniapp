{
  "name": "paiso-miniapp",
  "version": "1.0.0",
  "description": "Telegram Mini App - Task Earning App (TypeScript)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "npm run build && node --watch server.js",
    "start": "node server.js",
    "build:admin": "npx tsc -p tsconfig.client.json && node scripts/build-admin.js",
    "build:app": "npx tsc -p tsconfig.client.json && node scripts/build-app.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@types/nodemailer": "^8.0.2",
    "express": "^4.19.2",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
