{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": ".",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/server.ts", "src/types.ts"],
  "exclude": ["node_modules", "public"]
}
